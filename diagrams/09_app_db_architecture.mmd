flowchart TB
    subgraph "Flask rakendus"
        LOGIN["/login\nfn_kasutaja_tuvastamise_andmed"]
        SCH["/schedule\nloeb v_avalikud_treeningukorrad"]
        CRE["/manager/sessions/new\nkutsub fn_planeeri_treeningukord"]
        ACT["olekutoimingud\nopen/close/complete/cancel"]
        REG["/client/register ja cancel\nkutsub registreeringu funktsioone"]
        ATT["/trainer/attendance\nkutsub fn_marki_osalemine"]
    end

    subgraph "PostgreSQL kaitstud tuum"
        VIEWS["vaated\nrollipõhised lugemised"]
        FUNCS["funktsioonid\nkõik tavapärased kirjutused"]
        TRIG["triggerid\ninvariantide kontroll"]
        IDX["unikaalsed ja osalised indeksid"]
        TABLES["tabelid\ntreeningukord, registreering,\nosalemine, ruum, pädevus,\nvarustus ja nõuded"]
    end

    LOGIN -->|"SELECT kasutaja andmed"| FUNCS
    SCH -->|"SELECT rollipõhistest vaadetest"| VIEWS
    CRE -->|"SELECT fn_* uue korra loomiseks"| FUNCS
    ACT -->|"SELECT fn_* seisundimuutuseks"| FUNCS
    REG -->|"SELECT fn_* registreerimiseks ja tühistamiseks"| FUNCS
    ATT -->|"SELECT fn_marki_osalemine"| FUNCS

    FUNCS -->|"INSERT/UPDATE kontrollitud teel"| TABLES
    VIEWS -->|"loevad lähteandmeid"| TABLES
    TRIG -->|"keelavad kattuvused, vigased seisundid ja varustuse sobimatuse"| TABLES
    IDX -->|"keelavad duplikaadid"| TABLES
    FUNCS -->|"käivitavad invariantide kontrolli"| TRIG
    TABLES -->|"on vaadete allikas"| VIEWS
