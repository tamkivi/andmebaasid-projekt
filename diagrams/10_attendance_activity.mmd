        ERR["Kuvab DB vea"]
    end

    subgraph LANE_DB["PostgreSQL"]
        FN["fn_marki_osalemine"]
        ROLE{"Roll sobib?"}
        STATE{"Seisund SULETUD või TOIMUNUD?"}
        TIME{"Alguse_aeg on möödas?\nMitte liiga vara"}
        REG{"registreering on KINNIT?"}
        SAVE["Lisa või uuenda osalemine"]
    end

    START --> CHOOSE --> ROSTER --> MARK --> ROUTE --> FN --> ROLE
    ROLE -->|"[jah]"| STATE
