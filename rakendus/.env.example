# Kohaliku prototüübi konfiguratsioon. Need on näidisväärtused; ära kasuta
# neid kooli serveris ega päris keskkonnas.
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-this-local-demo-secret

# Kohaliku PostgreSQL andmebaasi näidisühendus
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jousaali
DB_USER=postgres
DB_PASSWORD=postgres

# Rakenduse port
PORT=5001
