digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Klassifikaatorid: tehnika ja bränd";
  "protsessor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>protsessor</B></FONT></TD></TR><TR><TD ALIGN="LEFT">protsessor_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">klassifikaatori_nimetus<BR/>[varchar(100)]</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_protsessor_kood_sisu: (((kood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_protsessor: (protsessor_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_protsessor_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_protsessor_nimetus: (nimetus)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">WITH (fillfactor=90)</FONT></TD></TR></TABLE>>];
  "sisemalu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>sisemalu</B></FONT></TD></TR><TR><TD ALIGN="LEFT">sisemalu_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">klassifikaatori_nimetus<BR/>[varchar(100)]</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_sisemalu_kood_positiivne: ((kood &gt; 0))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_sisemalu: (sisemalu_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_sisemalu_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_sisemalu_nimetus: (nimetus)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">WITH (fillfactor=90)</FONT></TD></TR></TABLE>>];
  "brand" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT">brand_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">klassifikaatori_nimetus<BR/>[varchar(100)]</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_brand_kood_sisu: (((kood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_brand: (brand_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_brand_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_brand_nimetus: (nimetus)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">WITH (fillfactor=90)</FONT></TD></TR></TABLE>>];
  "protsessor" -> "sisemalu" [style=invis, weight=100];
  "sisemalu" -> "brand" [style=invis, weight=100];
}
