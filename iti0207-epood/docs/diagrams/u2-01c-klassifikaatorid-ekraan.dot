digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Klassifikaatorid: ekraan ja kaamera";
  "diagonaal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>diagonaal</B></FONT></TD></TR><TR><TD ALIGN="LEFT">diagonaal_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">numeric(4,1)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_diagonaal_kood_positiivne: (((kood &gt; (0)::numeric) AND (kood &lt;&gt; &#x27;NaN&#x27;::numeric)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_diagonaal_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_diagonaal: (diagonaal_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_diagonaal_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_diagonaal_nimetus: (nimetus)</FONT></TD></TR></TABLE>>];
  "ekraani_resolutsioon" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>ekraani_resolutsioon</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ekraani_resolutsioon_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">horisontaalne</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">vertikaalne</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_ekraani_resolutsioon_horisontaalne_positiivne: ((horisontaalne &gt; 0))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_ekraani_resolutsioon_kood_sisu: (((kood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_ekraani_resolutsioon_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_ekraani_resolutsioon_vertikaalne_positiivne: ((vertikaalne &gt; 0))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_ekraani_resolutsioon: (ekraani_resolutsioon_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_ekraani_resolutsioon_horis_vert: (horisontaalne, vertikaalne)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_ekraani_resolutsioon_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_ekraani_resolutsioon_nimetus: (nimetus)</FONT></TD></TR></TABLE>>];
  "kaamera" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kaamera</B></FONT></TD></TR><TR><TD ALIGN="LEFT">kaamera_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">numeric(6,1)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaamera_kood_positiivne: (((kood &gt; (0)::numeric) AND (kood &lt;&gt; &#x27;NaN&#x27;::numeric)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaamera_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_kaamera: (kaamera_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_kaamera_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_kaamera_nimetus: (nimetus)</FONT></TD></TR></TABLE>>];
  "diagonaal" -> "ekraani_resolutsioon" [style=invis, weight=100];
  "ekraani_resolutsioon" -> "kaamera" [style=invis, weight=100];
}
