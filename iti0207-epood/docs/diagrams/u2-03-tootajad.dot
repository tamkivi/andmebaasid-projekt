digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Töötajate register";
  "tootaja" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>tootaja</B></FONT></TD></TR><TR><TD ALIGN="LEFT">tootaja_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">isik_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK; UK</TD></TR><TR><TD ALIGN="LEFT">tootaja_seisundi_liik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_tootaja_isik -&gt; isik [D CASCADE; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_tootaja_tootaja_seisundi_liik -&gt; tootaja_seisundi_liik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_tootaja: (tootaja_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_tootaja_isik: (isik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_tootaja_tootaja_seisundi_liik_id: (tootaja_seisundi_liik_id)</FONT></TD></TR></TABLE>>];
  "tootaja_rolli_omamine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>tootaja_rolli_omamine</B></FONT></TD></TR><TR><TD ALIGN="LEFT">tootaja_rolli_omamine_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">tootaja_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK; UK</TD></TR><TR><TD ALIGN="LEFT">tootaja_roll_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK; UK</TD></TR><TR><TD ALIGN="LEFT">alguse_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">lopu_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT &#x27;infinity&#x27;::timestamp with time zone</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_tootaja_rolli_omamine_ajaline_jarjestus: ((lopu_aeg &gt; alguse_aeg))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_tootaja_rolli_omamine_alguse_aeg_vahemik: (((alguse_aeg &gt;= &#x27;2010-01-01 00:00:00+02&#x27;::timestamptz)<BR ALIGN="LEFT"/>AND (alguse_aeg &lt; &#x27;2101-01-01 00:00:00+02&#x27;::timestamptz)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_tootaja_rolli_omamine_lopu_aeg_vahemik: (((lopu_aeg = &#x27;infinity&#x27;::timestamptz) OR ((lopu_aeg &gt;=<BR ALIGN="LEFT"/>&#x27;2010-01-01 00:00:00+02&#x27;::timestamptz) AND (lopu_aeg &lt; &#x27;2101-01-01 00:00:00+02&#x27;::timestamptz))))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_tootaja_rolli_omamine_roll -&gt; tootaja_roll [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_tootaja_rolli_omamine_tootaja -&gt; tootaja [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_tootaja_rolli_omamine: (tootaja_rolli_omamine_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_tootaja_rolli_omamine_algus: (tootaja_id, tootaja_roll_id, alguse_aeg)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_tootaja_rolli_omamine_tootaja_roll_id: (tootaja_roll_id)</FONT></TD></TR></TABLE>>];
  "isik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>isik</B></TD></TR></TABLE>>];
  "tootaja_roll" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>tootaja_roll</B></TD></TR></TABLE>>];
  "tootaja_seisundi_liik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>tootaja_seisundi_liik</B></TD></TR></TABLE>>];
  "isik" -> "tootaja";
  "tootaja_seisundi_liik" -> "tootaja";
  "tootaja_roll" -> "tootaja_rolli_omamine";
  "tootaja" -> "tootaja_rolli_omamine";
  { rank=same; "isik"; "tootaja_roll"; }
  "isik" -> "tootaja_seisundi_liik" [style=invis, weight=100];
  "tootaja_seisundi_liik" -> "tootaja" [style=invis, weight=100];
  "tootaja" -> "tootaja_rolli_omamine" [style=invis, weight=100];
}
