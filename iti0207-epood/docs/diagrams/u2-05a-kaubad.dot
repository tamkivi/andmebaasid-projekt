digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Kaupade register: kaup";
  "kaup" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kaup</B></FONT></TD></TR><TR><TD ALIGN="LEFT">kaup_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kauba_kood</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(255)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kauba_seisundi_liik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">brand_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">registreerija_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">viimase_muutja_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">hind</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kirjeldus</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">reg_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">viimase_muutm_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">pildi_aadress</TD><TD ALIGN="LEFT">varchar(500)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_ajaline_jarjestus: ((viimase_muutm_aeg &gt;= reg_aeg))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_hind_positiivne: (((hind &gt; (0)::numeric) AND (hind &lt;&gt; &#x27;NaN&#x27;::numeric)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_kalli_kauba_pilt: (((hind &lt;= (1000)::numeric) OR (pildi_aadress IS NOT NULL)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_kauba_kood_kuju: (((kauba_kood)::text ~ &#x27;^[A-Z]{3}[A-Z0-9]*$&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_kauba_kood_min_pikkus: ((char_length((kauba_kood)::text) &gt;= 6))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_kirjeldus_sisu: ((kirjeldus ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_nimetus_min_pikkus: ((char_length((nimetus)::text) &gt;= 4))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_pildi_aadress_kuju: (((pildi_aadress)::text ~ &#x27;\.(jpg|png)$&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_reg_aeg_vahemik: (((reg_aeg &gt;= &#x27;2010-01-01 00:00:00+02&#x27;::timestamptz) AND (reg_aeg &lt;<BR ALIGN="LEFT"/>&#x27;2101-01-01 00:00:00+02&#x27;::timestamptz)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kaup_viimase_muutm_aeg_vahemik: (((viimase_muutm_aeg &gt;= &#x27;2010-01-01 00:00:00+02&#x27;::timestamptz) AND<BR ALIGN="LEFT"/>(viimase_muutm_aeg &lt; &#x27;2101-01-01 00:00:00+02&#x27;::timestamptz)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_kaup_brand -&gt; brand [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_kaup_kauba_seisundi_liik -&gt; kauba_seisundi_liik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_kaup_registreerija -&gt; tootaja [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_kaup_viimase_muutja -&gt; tootaja [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_kaup: (kaup_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_kaup_kauba_kood: (kauba_kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_kaup_brand_id: (brand_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_kaup_kauba_seisundi_liik_id: (kauba_seisundi_liik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_kaup_registreerija_id: (registreerija_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_kaup_viimase_muutja_id: (viimase_muutja_id)</FONT></TD></TR></TABLE>>];
  "brand" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>brand</B></TD></TR></TABLE>>];
  "kauba_seisundi_liik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>kauba_seisundi_liik</B></TD></TR></TABLE>>];
  "tootaja" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>tootaja</B></TD></TR></TABLE>>];
  "brand" -> "kaup";
  "kauba_seisundi_liik" -> "kaup";
  "tootaja" -> "kaup";
  "tootaja" -> "kaup";
  { rank=same; "brand"; "kauba_seisundi_liik"; }
  "brand" -> "tootaja" [style=invis, weight=100];
  "tootaja" -> "kaup" [style=invis, weight=100];
}
