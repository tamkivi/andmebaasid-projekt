  "varv" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>varv</B></FONT></TD></TR><TR><TD ALIGN="LEFT">varv_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_varv_kood_sisu: (((kood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_varv_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_varv: (varv_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_varv_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_varv_nimetus: (nimetus)</FONT></TD></TR></TABLE>>];
  "kauba_kategooria_tyyp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kauba_kategooria_tyyp</B></FONT></TD></TR><TR><TD ALIGN="LEFT">kauba_kategooria_tyyp_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">kood</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">nimetus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kauba_kategooria_tyyp_kood_sisu: (((kood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kauba_kategooria_tyyp_nimetus_sisu: (((nimetus)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_kauba_kategooria_tyyp: (kauba_kategooria_tyyp_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_kauba_kategooria_tyyp_kood: (kood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_kauba_kategooria_tyyp_nimetus: (nimetus)</FONT></TD></TR></TABLE>>];
