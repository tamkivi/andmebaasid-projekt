digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Isikute register";
  "isik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>isik</B></FONT></TD></TR><TR><TD ALIGN="LEFT">isik_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">isikukood</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">e_meil</TD><TD ALIGN="LEFT">varchar(254)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">riik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK; UK</TD></TR><TR><TD ALIGN="LEFT">isiku_seisundi_liik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">synni_kp</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">reg_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">viimase_muutm_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">eesnimi</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD ALIGN="LEFT">perenimi</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD ALIGN="LEFT">elukoht</TD><TD ALIGN="LEFT">varchar(500)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">FK fk_isik_isiku_seisundi_liik -&gt; isiku_seisundi_liik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">FK fk_isik_riik -&gt; riik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">PK pk_isik: (isik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">UK uk_isik_e_meil: (e_meil)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">UK uk_isik_riik_isikukood: (riik_id, isikukood)</FONT></TD></TR></TABLE>>];
  "kasutajakonto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kasutajakonto</B></FONT></TD></TR><TR><TD ALIGN="LEFT">isik_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK; PK</TD></TR><TR><TD ALIGN="LEFT">parool</TD><TD ALIGN="LEFT">varchar(60)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">FK fk_kasutajakonto_isik -&gt; isik [D CASCADE; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="9">PK pk_kasutajakonto: (isik_id)</FONT></TD></TR></TABLE>>];
  "isiku_seisundi_liik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>isiku_seisundi_liik</B></TD></TR></TABLE>>];
  "riik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>riik</B></TD></TR></TABLE>>];
  "isiku_seisundi_liik" -> "isik";
  "riik" -> "isik";
  "isik" -> "kasutajakonto";
  "isiku_seisundi_liik" -> "riik" [style=invis, weight=100];
  "riik" -> "isik" [style=invis, weight=100];
  "isik" -> "kasutajakonto" [style=invis, weight=100];
}
