digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.1, nodesep=0.18, ranksep=0.15,
         fontname=Helvetica, fontsize=12, size="7.3,10.5", page="8.27,11.69", margin=0.2];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#667788", dir=none, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 - Isikute register";
  "isik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>isik</B></FONT></TD></TR><TR><TD ALIGN="LEFT">isik_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; PK; IDENTITY</TD></TR><TR><TD ALIGN="LEFT">isikukood</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NOT NULL; UK</TD></TR><TR><TD ALIGN="LEFT">e_meil</TD><TD ALIGN="LEFT">varchar(254)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">riik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK; UK</TD></TR><TR><TD ALIGN="LEFT">isiku_seisundi_liik_id</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL; FK</TD></TR><TR><TD ALIGN="LEFT">synni_kp</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">reg_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">viimase_muutm_aeg</TD><TD ALIGN="LEFT">timestamptz(0)</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">eesnimi</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD ALIGN="LEFT">perenimi</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD ALIGN="LEFT">elukoht</TD><TD ALIGN="LEFT">varchar(500)</TD><TD ALIGN="LEFT">NULL</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_ajaline_jarjestus: ((viimase_muutm_aeg &gt;= reg_aeg))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_e_meil_kuju: ((POSITION((&#x27;@&#x27;::text) IN (e_meil)) &gt; 0))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_eesnimi_sisu: (((eesnimi)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_elukoht_margid: (((elukoht)::text !~ &#x27;^[0-9]+$&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_elukoht_sisu: (((elukoht)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_isikukood_margid: (((isikukood)::text ~ &#x27;^[[:alpha:][:digit:] +/=\\-]+$&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_isikukood_sisu: (((isikukood)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_nimi_olemas: (((eesnimi IS NOT NULL) OR (perenimi IS NOT NULL)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_perenimi_sisu: (((perenimi)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_reg_aeg_vahemik: (((reg_aeg &gt;= &#x27;2010-01-01 00:00:00+02&#x27;::timestamptz) AND (reg_aeg &lt;<BR ALIGN="LEFT"/>&#x27;2101-01-01 00:00:00+02&#x27;::timestamptz)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_synni_kp_registreerimine: ((synni_kp &lt;= ((reg_aeg AT TIME ZONE<BR ALIGN="LEFT"/>&#x27;Europe/Tallinn&#x27;::text))::date))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_synni_kp_vahemik: (((synni_kp &gt;= &#x27;1900-01-01&#x27;::date) AND (synni_kp &lt;= &#x27;2100-12-31&#x27;::date)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_isik_viimase_muutm_aeg_vahemik: (((viimase_muutm_aeg &gt;= &#x27;2010-01-01 00:00:00+02&#x27;::timestamptz) AND<BR ALIGN="LEFT"/>(viimase_muutm_aeg &lt; &#x27;2101-01-01 00:00:00+02&#x27;::timestamptz)))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_isik_isiku_seisundi_liik -&gt; isiku_seisundi_liik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_isik_riik -&gt; riik [D NO ACTION; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_isik: (isik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UK uk_isik_riik_isikukood: (riik_id, isikukood)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">INDEX ix_isik_isiku_seisundi_liik_id: (isiku_seisundi_liik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">UNIQUE INDEX ux_isik_e_meil: (lower((e_meil)::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">WITH (fillfactor=90)</FONT></TD></TR></TABLE>>];
  "kasutajakonto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kasutajakonto</B></FONT></TD></TR><TR><TD ALIGN="LEFT">isik_id</TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL; FK; PK</TD></TR><TR><TD ALIGN="LEFT">parool</TD><TD ALIGN="LEFT">varchar(60)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">on_aktiivne</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL; DEFAULT true</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">CHECK ck_kasutajakonto_parool_sisu: (((parool)::text ~ &#x27;[^[:space:]]&#x27;::text))</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">FK fk_kasutajakonto_isik -&gt; isik [D CASCADE; U NO ACTION]</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">PK pk_kasutajakonto: (isik_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f2f5f8"><FONT POINT-SIZE="8">WITH (fillfactor=90)</FONT></TD></TR></TABLE>>];
  "isiku_seisundi_liik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>isiku_seisundi_liik</B></TD></TR></TABLE>>];
  "riik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8edf2"><B>riik</B></TD></TR></TABLE>>];
  "isiku_seisundi_liik" -> "isik";
  "riik" -> "isik";
  "isik" -> "kasutajakonto";
  { rank=same; "isiku_seisundi_liik"; "riik"; }
  "isiku_seisundi_liik" -> "isik" [style=invis, weight=100];
  "isik" -> "kasutajakonto" [style=invis, weight=100];
}
