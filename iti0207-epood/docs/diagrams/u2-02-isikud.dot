digraph G {
  graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.35, ranksep=0.55, fontname=Helvetica];
  node [shape=plaintext, fontname=Helvetica, fontsize=9];
  edge [color="#444444", arrowsize=0.7, fontsize=8, fontname=Helvetica];
  labelloc="t";
  label="ITI0207 Ü2 — Isikute register\n(local iti0207_epood_u2)";
  "isik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="4" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>isik</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>isik_id</B></TD><TD ALIGN="LEFT">integer IDENTITY</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT"><B>isikukood</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>e_meil</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>riik_id</B></TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>isiku_seisundi_liik_id</B></TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>synni_kp</B></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>reg_aeg</B></TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>viimase_muutm_aeg</B></TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>eesnimi</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>perenimi</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>elukoht</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  "kasutajakonto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="4" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>kasutajakonto</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>isik_id</B></TD><TD ALIGN="LEFT">integer</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT"><B>parool</B></TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT"><B>on_aktiivne</B></TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  "isiku_seisundi_liik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#6c757d"><FONT COLOR="white"><B>isiku_seisundi_liik</B> (kontekst)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>isiku_seisundi_liik_id</B></TD><TD ALIGN="LEFT">PK</TD></TR></TABLE>>];
  "klient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#6c757d"><FONT COLOR="white"><B>klient</B> (kontekst)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>isik_id</B></TD><TD ALIGN="LEFT">PK</TD></TR></TABLE>>];
  "riik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#6c757d"><FONT COLOR="white"><B>riik</B> (kontekst)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>riik_id</B></TD><TD ALIGN="LEFT">PK</TD></TR></TABLE>>];
  "tootaja" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#6c757d"><FONT COLOR="white"><B>tootaja</B> (kontekst)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>tootaja_id</B></TD><TD ALIGN="LEFT">PK</TD></TR></TABLE>>];
  "isik" -> "isiku_seisundi_liik" [label="isiku_seisundi_liik_id"];
  "isik" -> "riik" [label="riik_id"];
  "kasutajakonto" -> "isik" [label="isik_id"];
  "klient" -> "isik" [label="isik_id"];
  "tootaja" -> "isik" [label="isik_id"];
}
